---
import Layout from "../../layouts/Layout.astro";
import BlogCards from "../../components/BlogCards.astro";
---

<Layout
  title="Blog de massagem e bem-estar em Campinas | Priscila"
  description="Dicas para escolher seu espaço de massagem em Campinas, conhecer modalidades e se preparar para a sessão na Priscila."
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Blog</p>
      <h1>Blog da Priscila: informação para seu momento de bem-estar</h1>
      <p>
        Conheça as modalidades de massagem e encontre orientações práticas para
        organizar sua próxima sessão com Priscila em Campinas.
      </p>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <h2 class="section-heading">Dicas e guias de massagem em Campinas</h2>
      <BlogCards />
    </div>
  </section>
</Layout>

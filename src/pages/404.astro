---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Página não encontrada | Priscila"
  description="Acesse as páginas de massagem e contato da Priscila."
  noindex
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Erro 404</p>
      <h1>Esta página não foi encontrada</h1>
      <p>Encontre as modalidades de massagem ou as informações de contato.</p>
      <div class="actions">
        <a class="button button-gold" href="/">
          Voltar ao início
        </a>
        <a class="button button-outline" href="/especialidades/">
          Ver especialidades
        </a>
      </div>
    </div>
  </section>
</Layout>
